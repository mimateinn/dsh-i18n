{
  "name": "@mimateinn/dsh-i18n",
  "version": "0.2.0",
  "description": "20-locale internationalization with automatic translation for the DeepSeek Harness Web UI",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "i18n:check": "node scripts/check.mjs",
    "i18n:build": "node scripts/assemble.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "test": "npm run i18n:check && npm run i18n:build && node scripts/verify-converter.mjs && npm run verify:runtime"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "cordis": ">=4.0.0-rc.8 <5.0.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "i18n",
    "localization",
    "multilingual",
    "20-locales",
    "traditional-chinese",
    "rtl",
    "arabic"
  ],
  "files": [
    "index.mjs",
    "index.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.*.md",
    "LICENSE",
    "src",
    "scripts/locales.mjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mimateinn/dsh-i18n.git"
  },
  "homepage": "https://github.com/mimateinn/dsh-i18n#readme",
  "bugs": {
    "url": "https://github.com/mimateinn/dsh-i18n/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
